QUANTIFIRE_ENV=development
QUANTIFIRE_DATABASE_URL=sqlite:///./data/quantifire.db
QUANTIFIRE_SECRET_KEY=change-this-to-a-long-random-value
QUANTIFIRE_ADMIN_EMAIL=admin@example.com
QUANTIFIRE_ADMIN_PASSWORD=change-me-immediately
QUANTIFIRE_HOST=127.0.0.1
QUANTIFIRE_PORT=8787
QUANTIFIRE_STORAGE_ROOT=./data/storage
QUANTIFIRE_MAX_UPLOAD_MB=100
QUANTIFIRE_ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
QUANTIFIRE_SESSION_HTTPS_ONLY=false
QUANTIFIRE_TRUSTED_HOSTS=127.0.0.1,localhost
QUANTIFIRE_CLAMAV_HOST=
QUANTIFIRE_CLAMAV_PORT=3310
QUANTIFIRE_MISSION_CONTROL_URL=http://127.0.0.1:3000
QUANTIFIRE_MISSION_CONTROL_API_KEY=
QUANTIFIRE_OPENCLAW_CONFIG_PATH=
QUANTIFIRE_OPENCLAW_STATE_DIR=
QUANTIFIRE_CURRENCY=AUD
QUANTIFIRE_TAX_NAME=GST
QUANTIFIRE_TAX_RATE=0.10
QUANTIFIRE_JURISDICTION=NSW/ACT, Australia
QUANTIFIRE_DEFAULT_LENGTH_UNIT=mm
QUANTIFIRE_DEFAULT_AREA_UNIT=m2
