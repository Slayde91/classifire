CLASSIFIRE_ENV=development
CLASSIFIRE_DATABASE_URL=sqlite:///./data/classifire.db
CLASSIFIRE_SECRET_KEY=change-this-to-a-long-random-value
CLASSIFIRE_ADMIN_EMAIL=admin@example.com
CLASSIFIRE_ADMIN_PASSWORD=change-me-immediately
CLASSIFIRE_HOST=127.0.0.1
CLASSIFIRE_PORT=8787
CLASSIFIRE_STORAGE_ROOT=./data/storage
CLASSIFIRE_MAX_UPLOAD_MB=100
CLASSIFIRE_UPLOAD_INGRESS_CEILING_MB=100
CLASSIFIRE_TECHNICAL_PDF_PREVIEW_ENABLED=false
CLASSIFIRE_TECHNICAL_EXTRACTION_EXECUTOR_ENABLED=false
CLASSIFIRE_TECHNICAL_PARSER_ORPHAN_RECONCILIATION_ENABLED=false
CLASSIFIRE_ALLOWED_ORIGINS=http://127.0.0.1:8787,http://localhost:8787
CLASSIFIRE_SESSION_HTTPS_ONLY=false
CLASSIFIRE_TRUSTED_HOSTS=127.0.0.1,localhost
CLASSIFIRE_CLAMAV_HOST=
CLASSIFIRE_CLAMAV_PORT=3310
CLASSIFIRE_CLAMAV_STREAM_MAX_MB=100
CLASSIFIRE_MISSION_CONTROL_URL=http://127.0.0.1:3000
CLASSIFIRE_MISSION_CONTROL_API_KEY=
CLASSIFIRE_OPENCLAW_CONFIG_PATH=
CLASSIFIRE_OPENCLAW_STATE_DIR=
CLASSIFIRE_CURRENCY=AUD
CLASSIFIRE_TAX_NAME=GST
CLASSIFIRE_TAX_RATE=0.10
CLASSIFIRE_JURISDICTION=NSW/ACT, Australia
CLASSIFIRE_DEFAULT_LENGTH_UNIT=mm
CLASSIFIRE_DEFAULT_AREA_UNIT=m2
